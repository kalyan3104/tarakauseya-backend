HOST=127.0.0.1
PORT=3000
# Supabase transaction-mode pooler: used by application requests.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase session-mode pooler: used only for migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-a-long-random-production-secret
FRONTEND_ORIGIN=http://localhost:5173
# For durable uploads in production, create a public Supabase Storage bucket
# named product-images (or set a different SUPABASE_STORAGE_BUCKET).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images
